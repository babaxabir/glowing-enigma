# Copy to .env for local testing (do not commit .env)
NTFY_TOPIC=your-unique-secret-topic-name
# Optional: name used in the greeting (default: Babak)
# RECIPIENT_NAME=Babak
# Optional: bearer token if your ntfy topic is protected
# NTFY_TOKEN=
# Optional: self-hosted ntfy server URL (default: https://ntfy.sh)
# NTFY_SERVER=https://ntfy.sh
